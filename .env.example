# POLAR-TWIN Environment Configuration Example
# Copy to .env and provide your deployment-specific credentials

# Supabase Sovereign Cloud Backend Configuration (Do NOT use Insforge)
SUPABASE_URL=https://fpoxnocbznagepusczkk.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ACCESS_TOKEN=your_supabase_access_token_here
SUPABASE_PROJECT_REF=fpoxnocbznagepusczkk

# Cryptographic Zero-Trust Session & Token Secret
POLAR_TWIN_JWT_SECRET=your_cryptographically_secure_256bit_secret_here

# NCPOR & Meteorological Ingestion
NCPOR_METEOROLOGICAL_ENDPOINT=https://weather.open-meteo.com/v1/forecast

# Edge Telemetry Gateway Node
EDGE_DEVICE_ID=edge_node_bharati
EDGE_STATION_ID=station_bharati

# Allowed CORS Origins (comma-separated for production)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# FastAPI Server Port
PORT=8000
